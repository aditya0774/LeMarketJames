<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lemarketjames</groupId>
        <artifactId>lemarketjames-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!--
        The MarketDataService contract (interface + model: plain, framework-free, unit-testable on
        their own) plus a ready-made HTTP implementation (MarketDataClient) that any servlet service
        can use just by depending on this module and setting market.service.url. market-service
        provides the real implementation instead; core-service and holdings-service both consume
        MarketDataClient as-is, which is why this module needs spring-boot-starter-web.
    -->
    <artifactId>market-client</artifactId>
    <name>LeMarketJames Market Client</name>
    <description>MarketDataService contract, quote/instrument model, and a shared HTTP client implementation</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
