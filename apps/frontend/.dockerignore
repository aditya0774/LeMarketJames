# The image runs its own `npm install` on Linux. Copying the host's node_modules over it
# (e.g. a Windows install with win32 esbuild binaries) would break `ng build` inside the image.
node_modules
dist
.angular
coverage

# Saved test logs are not part of the build.
*.txt

# Neither are the unit tests: tsconfig.app.json leaves them out of `ng build`. Ignored here so a
# change that only touches tests doesn't rebuild the image.
**/*.spec.ts
