/* Staff app TypeScript settings; everything not set here comes from the workspace tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* Staff app uses @staff/* for its own code. The trading app's Auth service is imported via relative path. */
    "paths": {
      "@staff/*": ["./src/app/*"]
    }
  },
  "files": []
  /* "references" removed: causes TypeScript composite project issues with incremental compilation */
}
